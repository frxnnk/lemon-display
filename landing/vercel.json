{
  "redirects": [
    {
      "source": "/studio",
      "destination": "/studio/?mode=concept",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.stl",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Content-Type", "value": "model/stl" }
      ]
    },
    {
      "source": "/(.*)\\.(svg|png|webp|avif|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
